# PostgreSQL 连接串（Render Blueprint 自动注入，不需要手填）
DATABASE_URL=postgresql://user:password@host:5432/database

# 只有使用要求 TLS 的外部 PostgreSQL 时才设为 true。
# Render 同区域内部数据库连接保持 false/不设置即可。
DATABASE_SSL=false

# 可选：如果设置自定义域名，可固定二维码里生成的域名
# PUBLIC_BASE_URL=https://lubrication.example.com

# 可选：数据库连接池大小
DB_POOL_MAX=10
